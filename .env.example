# Environment Variables Example
# Copy this file to .env and fill in your values

# Flask
SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# Mail (optional – OTP shown in flash messages in dev mode if not set)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@yourschool.edu

# Database (defaults to SQLite if not set)
# DATABASE_URL=mysql://user:password@localhost/examiner
# DATABASE_URL=postgresql://user:password@localhost/examiner
